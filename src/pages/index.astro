---
import '../styles/global.css';
import IntegrationDemo from '../components/IntegrationDemo.vue';
import { siPhp, siSymfony, siLaravel, siVuedotjs, siRabbitmq, siPostgresql, siDocker } from 'simple-icons';

const email = 'canetarn05@gmail.com';
const cv = '/CV_Arnau_Canet.pdf';
const linkedin = 'https://www.linkedin.com/in/arnau-canet';
const github = 'https://github.com/arnaucanet';

const stackIcons = [
  ['PHP', siPhp], ['Symfony', siSymfony], ['Laravel', siLaravel], ['Vue.js', siVuedotjs],
  ['RabbitMQ', siRabbitmq], ['PostgreSQL', siPostgresql], ['Docker', siDocker],
];

const work = [
  { t: 'Validador inteligente de documentos', d: 'Integré en la plataforma el análisis y la verificación automática de documentos mediante LLM: diseño de la integración, backend en Symfony y comunicación con el microservicio a través de RabbitMQ.', tags: ['Symfony', 'RabbitMQ', 'LLM'] },
  { t: 'Chatbot conversacional interno', d: 'Integré el chatbot en la plataforma por HTTP y diseñé la gestión de sesiones de conversación. También desarrollé el componente de chat en Vue.js: interfaz redimensionable y descarga de la conversación en Word.', tags: ['Symfony', 'HTTP', 'Vue.js'] },
  { t: 'Sistema de créditos y tokens', d: 'Participé en el sistema que controla el consumo de IA de cada cliente: consumidores de RabbitMQ, planes de pruebas de QA, depuración en Symfony y Doctrine, y documentación técnica.', tags: ['RabbitMQ', 'Doctrine', 'QA'] },
];

const experience = [
  { role: 'Backend & AI Integration Developer', org: 'itbid', place: 'Barcelona, híbrido', dates: 'Oct 2025 – Jul 2026', text: 'Integración en la plataforma de dos productos de IA basados en LLM, sistema de créditos y tokens, y frontend del chat.' },
  { role: 'Técnico de sistemas', org: 'ADTEL Sistemas de Telecomunicación', place: 'Molins de Rei', dates: 'Jul 2024 – May 2025', text: 'Servidores Linux y Windows Server, red corporativa, monitorización, copias de seguridad y soporte.' },
  { role: 'Técnico informático en prácticas', org: 'Ajuntament de Sant Feliu de Llobregat', place: 'Sant Feliu de Llobregat', dates: 'Nov 2022 – May 2023', text: 'Soporte a usuarios, mantenimiento de equipos, redes e instalación de software.' },
];

const education = [
  { title: 'Curso de Especialización en IA y Big Data (Máster FP)', where: 'En curso, 2026 – 2027' },
  { title: 'CFGS Desarrollo de Aplicaciones Web (DAW)', where: 'IES Bernat el Ferrer, 2023 – 2026' },
  { title: 'CFGS Administración de Sistemas Informáticos en Red (ASIX)', where: 'IES Bernat el Ferrer, 2023 – 2025' },
  { title: 'CFGM Sistemas Microinformáticos y Redes (SMX)', where: 'IES Bernat el Ferrer' },
];

const title = 'Arnau Canet Català · Backend & AI Integration Developer';
const description = 'Desarrollador backend en PHP y Symfony que integra productos de inteligencia artificial en plataformas empresariales.';
const btnLight = 'inline-flex items-center gap-2 rounded-md bg-ink px-5 py-3 font-medium text-bg transition-colors hover:bg-white';
const btnOutline = 'inline-flex items-center gap-2 rounded-md border border-white/15 px-5 py-3 font-medium transition-colors hover:border-white/35 hover:bg-white/5';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://arnaucanet.github.io/" />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-bg">Saltar al contenido</a>

    <header class="sticky top-0 z-40 border-b border-white/[0.06] bg-bg/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
        <a href="/" class="font-bold tracking-tight">Arnau Canet Català</a>
        <nav class="flex items-center gap-1 text-sm sm:gap-2">
          <a class="hidden rounded-md px-3 py-2 text-muted hover:text-ink sm:inline" href="#trabajo">Trabajo</a>
          <a class="hidden rounded-md px-3 py-2 text-muted hover:text-ink sm:inline" href="#sobre-mi">Sobre mí</a>
          <a class="hidden rounded-md px-3 py-2 text-muted hover:text-ink sm:inline" href="#contacto">Contacto</a>
          <a href={cv} target="_blank" rel="noopener" class="ml-2 inline-flex items-center gap-2 rounded-md border border-white/15 px-4 py-2 font-semibold hover:border-white/35 hover:bg-white/5">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
            CV
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <section class="relative mx-auto flex min-h-[calc(100svh-4rem)] max-w-6xl flex-col justify-center px-5 py-20 sm:px-8">
        <div class="mx-auto w-full max-w-[46rem]">
          <p class="inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/[0.03] px-3 py-1.5 text-[13px] text-ink/85">
            <span class="status-dot h-2 w-2 rounded-full bg-accent"></span>
            Disponible para nuevos puestos <span class="text-muted">·</span> Barcelona
          </p>
          <h1 class="mt-7 text-[2.6rem] font-bold leading-[1.08] tracking-[-0.03em] sm:text-[4.1rem]">
            Integrando IA en
            <span class="glow block text-accent">productos reales.</span>
          </h1>
          <p class="mt-7 max-w-[36rem] text-lg leading-relaxed text-muted sm:text-xl sm:leading-relaxed">
            Desarrollador backend en PHP y Symfony. En itbid integré en la plataforma, en solitario,
            dos productos basados en LLM: un validador de documentos y un chatbot interno.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="#trabajo" class={btnLight}>
              Ver mi trabajo
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
            </a>
            <a href="#contacto" class={btnOutline}>Hablemos</a>
          </div>

          <p class="mt-14 font-mono text-xs uppercase tracking-[0.08em] text-muted">Stack principal:</p>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm text-ink/80">
            {stackIcons.map(([name, icon]) => (
              <li class="flex items-center gap-2">
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current opacity-80" aria-hidden="true"><path d={icon.path} /></svg>
                {name}
              </li>
            ))}
          </ul>
        </div>
        <a href="#trabajo" aria-label="Ir a mi trabajo" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-muted hover:text-ink">
          <svg viewBox="0 0 24 24" class="bob h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </a>
      </section>

      <section id="trabajo" class="border-t border-line">
        <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
          <div class="mx-auto max-w-[46rem] lg:max-w-none">
            <p class="font-mono text-xs uppercase tracking-[0.08em] text-accent">Trabajo seleccionado</p>
            <h2 class="mt-3 text-3xl font-bold tracking-[-0.02em] sm:text-4xl">IA integrada en itbid</h2>
            <p class="mt-5 max-w-[42rem] text-lg leading-relaxed text-muted">
              itbid es una plataforma de compras para empresas. Los microservicios de IA los desarrollaba un compañero;
              mi trabajo era que funcionaran dentro del producto, y esa parte la llevé yo solo de principio a fin.
            </p>

            <div class="mt-12 grid items-start gap-10 lg:grid-cols-[1fr_1.1fr]">
              <div>
                <IntegrationDemo client:idle />
                <p class="mt-3 text-sm text-muted">Así viaja una petición en cada producto.</p>
              </div>
              <div class="space-y-4">
                {work.map((w) => (
                  <article class="rounded-xl border border-line bg-surface p-6">
                    <h3 class="font-semibold">{w.t}</h3>
                    <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{w.d}</p>
                    <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs text-accent">
                      {w.tags.map((t) => <li class="rounded border border-accent/25 bg-accent/[0.06] px-2 py-0.5">{t}</li>)}
                    </ul>
                  </article>
                ))}
              </div>
            </div>

            <div class="mt-20">
              <h3 class="text-2xl font-bold tracking-tight">Proyectos</h3>
              <article class="ticket mt-6 max-w-[46rem] overflow-hidden rounded-xl border border-line bg-surface">
                <div class="grid sm:grid-cols-[1fr_11rem]">
                  <div class="p-7 sm:p-8">
                    <p class="text-sm text-muted">Proyecto final de DAW</p>
                    <h4 class="mt-1 text-2xl font-bold tracking-tight">GoEvent</h4>
                    <p class="mt-3 leading-relaxed text-muted">
                      Plataforma de venta de entradas para eventos, al estilo de Ticketmaster. API REST en Laravel y frontend en Vue.js.
                    </p>
                  </div>
                  <ul class="flex items-center gap-4 border-t border-dashed border-white/15 p-7 font-mono text-sm text-accent sm:flex-col sm:items-start sm:justify-center sm:border-l sm:border-t-0">
                    <li>Laravel</li><li>API REST</li><li>Vue.js</li>
                  </ul>
                </div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section id="sobre-mi" class="border-t border-line">
        <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-accent">Sobre mí</p>
          <h2 class="mt-3 max-w-[40rem] text-3xl font-bold tracking-[-0.02em] sm:text-4xl">Backend con base de sistemas</h2>
          <p class="mt-5 max-w-[42rem] text-lg leading-relaxed text-muted">
            Vengo de sistemas: antes de dedicarme al desarrollo administré servidores y redes en ADTEL y en el
            Ajuntament de Sant Feliu de Llobregat. Ahora me estoy especializando en IA y Big Data.
          </p>

          <div class="mt-14 grid gap-14 lg:grid-cols-2">
            <div>
              <h3 class="font-mono text-xs uppercase tracking-[0.08em] text-muted">Experiencia</h3>
              <ol class="relative mt-6">
                <span class="absolute bottom-2 left-[5px] top-2 w-px bg-line" aria-hidden="true"></span>
                {experience.map((e, i) => (
                  <li class="relative pb-10 pl-8 last:pb-0">
                    <span class={`absolute left-0 top-[7px] h-[11px] w-[11px] rounded-full border-2 ${i === 0 ? 'border-accent bg-accent' : 'border-muted/60 bg-bg'}`}></span>
                    <p class="font-mono text-xs text-muted">{e.dates}</p>
                    <h4 class="mt-1 font-semibold">{e.role}</h4>
                    <p class="text-sm text-muted">{e.org}, {e.place}</p>
                    <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/85">{e.text}</p>
                  </li>
                ))}
              </ol>
            </div>
            <div>
              <h3 class="font-mono text-xs uppercase tracking-[0.08em] text-muted">Formación</h3>
              <ul class="mt-6 space-y-6">
                {education.map((e, i) => (
                  <li>
                    <h4 class="font-semibold leading-snug">{e.title}</h4>
                    <p class={`mt-1 text-sm ${i === 0 ? 'text-accent' : 'text-muted'}`}>{e.where}</p>
                  </li>
                ))}
                <li>
                  <h4 class="font-semibold leading-snug">JavaScript Algorithms and Data Structures</h4>
                  <p class="mt-1 text-sm text-muted">Certificación de freeCodeCamp</p>
                </li>
              </ul>
              <h3 class="mt-12 font-mono text-xs uppercase tracking-[0.08em] text-muted">Idiomas</h3>
              <p class="mt-4">Español y catalán nativos, inglés intermedio.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="contacto" class="border-t border-line">
        <div class="mx-auto max-w-6xl px-5 py-28 text-center sm:px-8">
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-accent">Contacto</p>
          <h2 class="mx-auto mt-3 max-w-[36rem] text-3xl font-bold tracking-[-0.02em] sm:text-5xl sm:leading-tight">
            ¿Hablamos de tu próximo proyecto?
          </h2>
          <p class="mx-auto mt-5 max-w-[32rem] text-lg text-muted">Disponible para incorporarme ya en la zona de Barcelona.</p>
          <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a href={`mailto:${email}`} class={btnLight}>{email}</a>
            <a href={linkedin} target="_blank" rel="noopener" class={btnOutline}>LinkedIn</a>
            <a href={github} target="_blank" rel="noopener" class={btnOutline}>GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-8 text-sm text-muted sm:px-8">
        <p>© {new Date().getFullYear()} Arnau Canet Català</p>
        <p>Hecho con Astro, Vue.js y Tailwind CSS</p>
      </div>
    </footer>
  </body>
</html>
